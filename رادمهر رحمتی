            border-radius: 5px;
            padding-right: 10px;
        }
        button {
            width: 50px;
            height: 50px;
            font-size: 18px;
            margin: 3px;
            border: none;
            background-color: #e0e0e0;
            border-radius: 5px;
            cursor: pointer;
        }
        button:hover {
            background-color: #d3d3d3;
        }
