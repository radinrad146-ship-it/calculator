<script>
    //  - ساخته شده توسط رادمهر رحمتی
    let display = document.getElementById('display');
    let buttons = document.querySelectorAll('button');

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            let val = btn.textContent;
            if (val === 'C') {
                display.value = '';
            } else if (val === '=') {
                try {
                    display.value = eval(display.value);
                } catch {
                    display.value = 'Error';
                }
            } else {
                display.value += val;
            }
        });
    });
</script>
